# Copy to .env.local for local SPA development.

# Optional: base URL of the API Worker when it is not served from the same origin as
# the SPA. Leave unset to use same-origin `/api`, which is the default in dev (Vite
# proxies to `wrangler dev`) and in production (the Worker serves dist/).
# VITE_API_BASE_URL="http://127.0.0.1:8787"

# There is no AI provider key to set here: the `/api/ai` coach runs on Cloudflare
# Workers AI through the `AI` binding in wrangler.jsonc. Worker secrets live in
# .dev.vars (see .dev.vars.example).
