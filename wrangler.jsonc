{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "migsim",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Workers AI: the /api/ai coaching endpoint runs inference through this binding.
  // Requires the Workers AI product to be enabled on the account.
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "migsim-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  }
  // Deploy with ENVIRONMENT=production so `worker/index.ts` stops allowing the
  // localhost dev origins, e.g. `wrangler deploy --var ENVIRONMENT:production`.
  // Secrets are never stored here:
  //   wrangler secret put JWT_SECRET
}
